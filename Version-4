def carregar_credenciais_smtp():
    usuario = os.getenv('SMTP_USER')
    senha = os.getenv('SMTP_PASSWORD')
    if not usuario or not senha:
        try:
            import local_settings  # type: ignore
            usuario = usuario or getattr(local_settings, 'SMTP_USER', None)
            senha = senha or getattr(local_settings, 'SMTP_PASSWORD', None)
        except Exception:
            pass

    if not usuario or not senha:
        logging.error("❌ Credenciais SMTP não encontradas! Defina no .env ou local_settings.py.")
        return None

    return usuario, senha

